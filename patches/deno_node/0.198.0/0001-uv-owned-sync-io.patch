+/// Block until `fd` is ready for `events` (POLLIN/POLLOUT). Sync Node fs I/O
+/// on a uv-owned fd must look blocking to the caller even if libuv left the
+/// descriptor non-blocking.
+#[cfg(unix)]
+fn wait_uv_owned(fd: i32, events: libc::c_short) -> Result<(), FsError> {
+  let mut pfd = libc::pollfd {
+    fd,
+    events,
+    revents: 0,
+  };
+  loop {
+    // SAFETY: pfd is a valid pollfd with a live fd for the duration of the
+    // call; timeout -1 waits indefinitely, matching synchronous I/O.
+    let ready = unsafe { libc::poll(&mut pfd, 1, -1) };
+    if ready >= 0 {
+      return Ok(());
+    }
+    let err = std::io::Error::last_os_error();
+    if err.raw_os_error() == Some(libc::EINTR) {
+      continue;
+    }
+    return Err(err.into());
+  }
+}
+
+/// Synchronous read from a uv-owned fd. No dup, no FdTable mutation, and no
+/// ownership transfer: libuv remains responsible for closing the fd.
+#[cfg(unix)]
+fn read_uv_owned(fd: i32, buf: &mut [u8]) -> Result<u32, FsError> {
+  loop {
+    // SAFETY: the buffer is valid for writes of buf.len() bytes and fd is a
+    // live descriptor owned by this process.
+    let nread = unsafe { libc::read(fd, buf.as_mut_ptr().cast(), buf.len()) };
+    if nread >= 0 {
+      return Ok(nread as u32);
+    }
+    let err = std::io::Error::last_os_error();
+    match err.raw_os_error() {
+      Some(libc::EINTR) => continue,
+      Some(libc::EAGAIN) => {
+        wait_uv_owned(fd, libc::POLLIN)?;
+        continue;
+      }
+      _ => return Err(err.into()),
+    }
+  }
+}
+
+/// Synchronous write to a uv-owned fd. Handles partial writes and EAGAIN.
+/// No dup, no FdTable mutation, and no ownership transfer.
+#[cfg(unix)]
+fn write_uv_owned(fd: i32, buf: &[u8]) -> Result<u32, FsError> {
+  let mut total = 0usize;
+  while total < buf.len() {
+    // SAFETY: the remaining slice is valid and fd is a live descriptor owned
+    // by this process.
+    let written = unsafe {
+      libc::write(
+        fd,
+        buf[total..].as_ptr().cast(),
+        buf.len() - total,
+      )
+    };
+    if written > 0 {
+      total += written as usize;
+      continue;
+    }
+    if written == 0 {
+      break;
+    }
+    let err = std::io::Error::last_os_error();
+    match err.raw_os_error() {
+      Some(libc::EINTR) => continue,
+      Some(libc::EAGAIN) => {
+        wait_uv_owned(fd, libc::POLLOUT)?;
+        continue;
+      }
+      _ => return Err(err.into()),
+    }
+  }
+  Ok(total as u32)
+}
