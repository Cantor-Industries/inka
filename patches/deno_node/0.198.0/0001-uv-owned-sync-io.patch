+/// True when `fd` is tracked by `FdTable` but has no `File` backing it. This
+/// is the `UvOwned` case: libuv owns a pipe/socket fd created for a child
+/// process, and `FdTable::get` deliberately returns `None` for it.
+#[cfg(unix)]
+fn uv_owned_fd(state: &OpState, fd: i32) -> bool {
+  let table = state.borrow::<deno_io::FdTable>();
+  table.contains(fd) && table.get(fd).is_none()
+}
